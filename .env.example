# Use the parent Knowledge folder containing Transcripts, Books, Notes, and other categories.
KNOWLEDGE_SOURCE_ROOT=
# Keep this alias stable if the folder moves to another machine.
KNOWLEDGE_SOURCE_ROOT_ALIAS=primary
# Parsed previews and source snapshots remain local and are ignored by Git.
KNOWLEDGE_RUNTIME_DIR=.local/ingestion-runs

# Set these only for an explicitly selected live enrichment run.
OPENROUTER_API_KEY=
KNOWLEDGE_EXTRACTION_MODEL=
KNOWLEDGE_EXTRACTION_MODEL_VERSION=
KNOWLEDGE_EMBEDDING_MODEL=
KNOWLEDGE_EMBEDDING_MODEL_VERSION=
KNOWLEDGE_EMBEDDING_DIMENSIONS=

# Server-side direct or session-pooled Postgres connection as knowledge_runtime.
# Set its password and role membership outside this repository.
KNOWLEDGE_DATABASE_URL=
